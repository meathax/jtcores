CORENAME=JTMOO
JTFRAME_RATE=59.19
JTFRAME_MR_DDRLOAD

JTFRAME_HEADER=16
# Konami 16-bit layout: 4 directions, 3 buttons, start. doc/moo.cpp:708-713 uses
# KONAMI16_LSB/MSB(n, IPT_BUTTON3, IPT_STARTn), and jtmoo_main.v declares [6:0].
JTFRAME_BUTTONS=3
JTFRAME_JOY_DURL
JTFRAME_OSD_TEST
JTFRAME_STEREO
# Video configuration
JTFRAME_COLORW=8
JTFRAME_PXLCLK=8
JTFRAME_WIDTH=384
JTFRAME_HEIGHT=224

JTFRAME_CREDITS_HSTART=24
JTFRAME_DEBUG_VPOS=5

# MB8464 (8 kB) sound work RAM
SND_RAMW=13

# default EEPROM needed to prevent game from booting upside down with error
JTFRAME_IOCTL_RD=128
debug JTFRAME_IOCTL_RD+=36897

[mist|sidi]
# not enough BRAM
JTFRAME_SKIP
